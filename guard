#!/bin/bash
# Builds and installs the Lock Guard menu bar app. Usage: ./guard build|install|uninstall|log|check
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$ROOT/build/Lock Guard.app"
INSTALLED="$HOME/Applications/Lock Guard.app"
LOG="$HOME/Library/Logs/lock-guard.log"
OLD_AGENT="com.alex-quiterio.lock-guard"
LOGIN_PLIST="$HOME/Library/LaunchAgents/com.alex-quiterio.lock-guard.login.plist"

build() {
  rm -rf "$APP"
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  cp "$ROOT/Resources/Info.plist" "$APP/Contents/Info.plist"
  cp "$ROOT/Resources/notify.applescript" "$ROOT/Resources/AppIcon.icns" "$APP/Contents/Resources/"
  swiftc -O "$ROOT"/Sources/*.swift -o "$APP/Contents/MacOS/Lock Guard"
  codesign --force --sign - "$APP" >/dev/null 2>&1 || true
  echo "built $APP"
}

# The first version ran as a background agent; remove it so you don't get two notifications.
remove_old_agent() {
  launchctl bootout "gui/$(id -u)/$OLD_AGENT" >/dev/null 2>&1 || true
  rm -f "$HOME/Library/LaunchAgents/$OLD_AGENT.plist"
}

install() {
  build
  remove_old_agent
  pkill -x "Lock Guard" >/dev/null 2>&1 || true
  while pgrep -x "Lock Guard" >/dev/null; do sleep 0.2; done
  mkdir -p "$HOME/Applications"
  rm -rf "$INSTALLED"
  cp -R "$APP" "$INSTALLED"
  open "$INSTALLED"
  echo "installed $INSTALLED; look for the shield in the menu bar"
}

uninstall() {
  pkill -x "Lock Guard" >/dev/null 2>&1 || true
  remove_old_agent
  rm -f "$LOGIN_PLIST"
  rm -rf "$INSTALLED"
  echo "uninstalled"
}

case "${1:-}" in
  build) build ;;
  install) install ;;
  uninstall) uninstall ;;
  log) tail -n "${2:-40}" "$LOG" 2>/dev/null || echo "no reports yet" ;;
  check) [ -d "$APP" ] || build; "$APP/Contents/MacOS/Lock Guard" check "${2:-10}" ;;
  *) echo "usage: ./guard build|install|uninstall|log [lines]|check [minutes]"; exit 1 ;;
esac
